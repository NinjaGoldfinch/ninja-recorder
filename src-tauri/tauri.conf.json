{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ninja-recorder",
  "version": "0.8.0",
  "identifier": "com.ninjarecorder.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/*",
          "$APPDATA/recordings/audio-tracks/*",
          "$APPDATA/ddragon/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NinjaGoldfinch/ninja-recorder/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_ME_WITH_THE_MINISIGN_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
