{
  "name": "ninja-recorder",
  "private": true,
  "version": "2.0.0",
  "license": "GPL-2.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:devtools": "tsc && NINJA_DEVTOOLS=1 vite build",
    "tauri:dev": "tauri dev --features devtools",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tauri-apps/cli": "^2",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
