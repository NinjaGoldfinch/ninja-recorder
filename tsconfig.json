{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* import.meta.env / import.meta.hot */
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `.svelte` is spelled out because a bare directory only matches the
  // extensions TypeScript itself compiles. `svelte-check` reads this list to
  // decide which components belong to the project, so without the second
  // pattern it type-checks the `.ts` files and silently skips every component
  // — which is the exact gap WS4.1 exists to close. `tsc` ignores the entries
  // it cannot compile, so naming them here costs it nothing.
  "include": ["src", "src/**/*.svelte"]
}
